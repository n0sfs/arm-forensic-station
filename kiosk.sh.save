  GNU nano 8.4                        kiosk.sh *                                
#!/bin/bash
xset s off
xset -dpms
xset s noblank

unclutter -idle 0.5 -root &

until $(curl --output /dev/null --silent --head --fail http://localhost:5000); >
    sleep 1
done

chromium-browser --kiosk --noerrdialogs --disable-infobars --check-for-upd
